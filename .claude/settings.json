{
    "permissions": {
        "allow": [
            "Bash(composer:*)",
            "Bash(vendor/bin/*:*)"
        ]
    },
    "hooks": {
        "PostToolUse": [
            {
                "matcher": "Edit|Write",
                "hooks": [
                    {
                        "type": "command",
                        "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/format-and-analyse.sh\"",
                        "timeout": 30
                    }
                ]
            }
        ]
    }
}
