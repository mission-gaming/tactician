# Every text file is stored and checked out with LF line endings. The
# repository tracks no binary files; add a `binary` rule here with the first.
* text=auto eol=lf

# Golden fixtures are compared byte for byte: keep their line endings fixed
tests/Fixtures/golden/** text eol=lf

# The dist archive carries only what is needed to use the library: src/,
# composer.json, LICENSE, README.md and CHANGELOG.md. Everything else at the
# root is listed here; tests/Feature/DistArchiveTest.php fails when a new root
# entry is missing from this list. Keep the leading slash: without it a
# pattern matches at every depth and can remove files from src/ as well.
/.claude               export-ignore
/.editorconfig         export-ignore
/.gitattributes        export-ignore
/.github               export-ignore
/.gitignore            export-ignore
/.php-cs-fixer.dist.php export-ignore
/AGENTS.md             export-ignore
/CLAUDE.md             export-ignore
/SECURITY.md           export-ignore
/composer.lock         export-ignore
/docs                  export-ignore
/examples              export-ignore
/phpstan.neon          export-ignore
/phpunit.xml           export-ignore
/rector.php            export-ignore
/tests                 export-ignore
