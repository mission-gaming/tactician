# What both PHPStan configurations share. It is not a configuration to run:
# phpstan.neon (src/, level 9) and phpstan-tests.neon (tests/ and
# examples/support/, level 8) include it and add their own level and paths.
includes:
	# Use of anything marked @deprecated is an error.
	- vendor/phpstan/phpstan-deprecation-rules/rules.neon
	# The strict rule set, whole: no rule in it is switched off. What the
	# code did not meet when it was enabled is in the two baseline files.
	- vendor/phpstan/phpstan-strict-rules/rules.neon

parameters:
	# Strict rules for better type safety. Note: the PHPStan 1.x options
	# checkMissingIterableValueType, checkGenericClassInNonGenericObjectType,
	# and the checkAlwaysTrue* family were removed in PHPStan 2 (their
	# behavior is now always on).
	checkMissingCallableSignature: true
	checkMissingOverrideMethodAttribute: true
	treatPhpDocTypesAsCertain: false

	# Error reporting
	reportUnmatchedIgnoredErrors: true
	reportStaticMethodSignatures: true

	# Type coverage settings
	checkMaybeUndefinedVariables: true

	# Scope strictness
	polluteScopeWithLoopInitialAssignments: false
	polluteScopeWithAlwaysIterableForeach: false

	# Exception analysis
	exceptions:
		check:
			missingCheckedExceptionInThrows: true
			tooWideThrowType: true

		# Unchecked: a method need not declare these in `@throws`.
		# InvalidArgumentException extends LogicException, so its entry
		# is there for the reader; the LogicException entry alone already
		# covers it.
		uncheckedExceptionClasses:
			- 'LogicException'
			- 'InvalidArgumentException'
			- 'BadMethodCallException'
