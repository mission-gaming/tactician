{
    "name": "mission-gaming/tactician",
    "description": "A modern PHP library for generating structured tournament schedules with deterministic algorithms like Round Robin, Swiss, and Pool play",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "tournament",
        "scheduling",
        "round-robin",
        "swiss",
        "pool-play",
        "fixtures",
        "pairing",
        "competition"
    ],
    "authors": [
        {
            "name": "Jamie Hollern",
            "email": "jamie@missiongaming.gg"
        }
    ],
    "homepage": "https://github.com/mission-gaming/tactician",
    "support": {
        "issues": "https://github.com/mission-gaming/tactician/issues",
        "source": "https://github.com/mission-gaming/tactician",
        "security": "https://github.com/mission-gaming/tactician/security/policy"
    },
    "require": {
        "php": "^8.3"
    },
    "require-dev": {
        "ergebnis/composer-normalize": "^2.39",
        "friendsofphp/php-cs-fixer": "^3.0",
        "pestphp/pest": "^4.0",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "rector/rector": "^2.0"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "MissionGaming\\Tactician\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MissionGaming\\Tactician\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true,
            "pestphp/pest-plugin": true
        },
        "optimize-autoloader": true,
        "platform": {
            "php": "8.3.0"
        },
        "sort-packages": true
    },
    "scripts": {
        "bench": [
            "Composer\\Config::disableProcessTimeout",
            "@php tests/bin/run-benchmarks.php"
        ],
        "bench-compare": [
            "Composer\\Config::disableProcessTimeout",
            "@php tests/bin/compare-benchmarks.php"
        ],
        "bench-install": "@composer install --working-dir=tools/phpbench",
        "ci": [
            "@norm",
            "@phpstan",
            "@rector",
            "@cs-fixer",
            "@test",
            "@examples"
        ],
        "cs-fixer": "php-cs-fixer fix --dry-run --diff",
        "cs-fixer-fix": "php-cs-fixer fix",
        "examples": "@php tests/bin/run-examples.php",
        "golden-update": [
            "@putenv UPDATE_GOLDEN=1",
            "pest tests/Feature/GoldenOutputTest.php"
        ],
        "norm": "composer normalize --dry-run",
        "norm-fix": "composer normalize",
        "phpstan": [
            "phpstan analyse --memory-limit=512M",
            "phpstan analyse --configuration=phpstan-tests.neon --memory-limit=512M"
        ],
        "rector": "rector process --dry-run",
        "rector-fix": "rector process",
        "security-audit": "@composer audit --locked --abandoned=report",
        "test": "pest",
        "test-coverage": [
            "@putenv XDEBUG_MODE=coverage",
            "pest --coverage --coverage-clover=build/clover.xml"
        ]
    }
}
