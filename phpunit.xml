<?xml version="1.0" encoding="UTF-8"?>
<!--
    A test run fails on anything PHP or PHPUnit reports, not only on a failed
    assertion: a warning, a notice, a deprecation, or a risky test (one that
    asserts nothing or prints output). The displayDetailsOn* attributes make
    the run say where each one came from.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/12.5/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         executionOrder="random"
         failOnWarning="true"
         failOnNotice="true"
         failOnDeprecation="true"
         failOnRisky="true"
         failOnPhpunitDeprecation="true"
         failOnPhpunitNotice="true"
         failOnPhpunitWarning="true"
         beStrictAboutOutputDuringTests="true"
         displayDetailsOnTestsThatTriggerWarnings="true"
         displayDetailsOnTestsThatTriggerNotices="true"
         displayDetailsOnTestsThatTriggerDeprecations="true"
         displayDetailsOnTestsThatTriggerErrors="true"
         displayDetailsOnPhpunitDeprecations="true"
         displayDetailsOnPhpunitNotices="true"
>
    <testsuites>
        <testsuite name="Test Suite">
            <directory suffix="Test.php">./tests</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory suffix=".php">./src</directory>
        </include>
    </source>
    <!--
        No memory_limit is set here, on purpose. The suite peaks a few
        megabytes either side of PHP's default limit of 128M (125 to 127 MB
        measured), and a run that collects coverage needs about 1.1 GB with
        either driver (1,077 MB with Xdebug, 1,084 MB with PCOV), nearly all
        of it where the coverage is reported after the last test. An
        <ini name="memory_limit"> here
        would set the value outright, and so lower the limit of a run that
        has a higher one or none, which is what PHP has on a CI runner: a
        stated 1G ended the Coverage job after every test had passed.
        tests/Pest.php raises a limit that is below 4G to 4G and leaves any
        other alone (tests/Support/SuiteMemoryLimit.php).
    -->
</phpunit>
