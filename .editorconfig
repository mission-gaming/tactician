# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Trailing spaces can be a hard line break in Markdown.
[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2

# `composer normalize` writes composer.json without a final newline.
[*.json]
insert_final_newline = unset

[*.neon]
indent_style = tab

# Fixtures are generated and compared byte for byte: never reformat them.
[tests/Fixtures/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset
